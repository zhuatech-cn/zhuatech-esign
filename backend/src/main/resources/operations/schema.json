{
  "slug": "esign",
  "title": "签署进度与证据时限核对",
  "fields": [
    {
      "key": "id",
      "label": "记录编号",
      "type": "ID"
    },
    {
      "key": "requiredSigners",
      "label": "必签人数",
      "type": "NUMBER",
      "scale": 0,
      "min": "1",
      "max": "1000000"
    },
    {
      "key": "completedSigners",
      "label": "已签人数",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "1000000"
    },
    {
      "key": "deadline",
      "label": "签署截止",
      "type": "DATE"
    },
    {
      "key": "evidence",
      "label": "证据状态",
      "type": "ENUM",
      "options": [
        "VALID",
        "INVALID"
      ]
    },
    {
      "key": "voided",
      "label": "已作废",
      "type": "ENUM",
      "options": [
        "YES",
        "NO"
      ]
    }
  ],
  "columns": [
    {
      "key": "missingSigners",
      "label": "缺签人数"
    },
    {
      "key": "remainingDays",
      "label": "截止剩余天数"
    }
  ],
  "description": "合并必签人数、签署进度、期限、证据校验和作废状态生成签署续办建议。",
